# Server Configuration
PORT=3000

# Browser Configuration
# Set to false to see the browser window (useful for debugging)
BROWSER_HEADLESS=true

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# Optional: Custom browser executable path
# AGENT_BROWSER_EXECUTABLE_PATH=/path/to/chromium

# Optional: Browser launch arguments
# AGENT_BROWSER_ARGS=--no-sandbox,--disable-gpu
